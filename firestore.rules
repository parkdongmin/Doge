rules_version = '2';

// Doge 행성 방치 시뮬레이터 — Firestore 보안 규칙
//
// 클라이언트가 직접 건드리는 컬렉션은 아래 2개뿐이다.
//   saves/{uid}   — 클라우드 세이브 (GameSnapshot JSON 1문서)
//   users/{uid}   — 인증 프로필 + 리더보드 통계
//
// 알림은 전부 기기 로컬(WorkManager)이라 서버/FCM 경로가 없다.
// 그 외 경로는 전부 차단한다.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 클라우드 세이브 ────────────────────────────────
    // 본인 문서만 읽고 쓴다. (이전엔 catch-all read 때문에 로그인한
    // 아무나 남의 세이브를 읽을 수 있었음 — 그 구멍을 막는 게 이 파일의 목적)
    match /saves/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── 유저 프로필 + 리더보드 ─────────────────────────
    // 리더보드가 users 컬렉션을 totalAsset 정렬로 상위 50명 조회하므로
    // 로그인 유저에게 read는 열어야 한다. write는 본인 문서만.
    // 문서에 담기는 필드: uid·displayName·createdAt·lastLoginAt(민원대응용) +
    // 리더보드 통계(totalAsset·coins·planetCount·assetUpdatedAt). email·photoUrl·
    // fcmToken은 저장하지 않는다(2026-08-31 제거 — 다른 유저에게 읽혀도 무방하도록).
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── 그 외 전부 차단 ───────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
